# Copy to .env.prod and replace every value before deployment.
# Never commit .env.prod.

APP_SECRET=change_me_openssl_rand_hex_32
# Generate both once and keep them stable:
#   APP_SECRET:          openssl rand -hex 32
#   APP_ENCRYPTION_KEY:  echo "base64:$(openssl rand -base64 32)"
# Changing APP_ENCRYPTION_KEY makes previously encrypted medical notes unreadable.
APP_ENCRYPTION_KEY=base64:change_me_32_bytes_base64
APP_URL=https://example.org
ADMIN_PHONE=+375290000000
ADMIN_PASSWORD=change_me_admin_password

MYSQL_DATABASE=senior_care
MYSQL_USER=senior
MYSQL_PASSWORD=change_me_mysql_password
MYSQL_ROOT_PASSWORD=change_me_mysql_root_password
MYSQL_EXPORTER_PASSWORD=change_me_exporter_password

METRICS_TOKEN=change_me_metrics_token
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
GRAFANA_ROOT_URL=http://localhost:3000

# Edge: use ":80" for local HTTP or a real domain (e.g. care.example.org) for automatic HTTPS
CADDY_DOMAIN=:80
HTTP_PORT=80
HTTPS_PORT=443

BACKUP_RETENTION_DAYS=7

GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
