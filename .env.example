APP_NAME=Senior Care Platform
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Local demo shortcuts. Keep ALLOW_DEMO_AUTH=false outside local/testing:
# it enables X-Demo-User impersonation and the passwordless demo senior login.
ALLOW_DEMO_AUTH=true
# Kiosk mode only: silently signs a fresh browser in as one elderly device.
# Leave false to show the neutral guest screen and let the visitor choose.
ELDERLY_AUTO_LOGIN=false
ELDERLY_DEMO_PHONE=+375291112233

# MySQL is the only supported database (dev, test and production).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
# 3307 for docker compose mysql; use 3306 for a locally installed MySQL.
DB_PORT=3307
DB_DATABASE=senior_care
DB_USERNAME=senior
DB_PASSWORD=seniorpass

# AI & Geo-matching Parameters
GEO_MAX_RADIUS_KM=5.0
WEIGHT_DISTANCE=0.5
WEIGHT_RATING=0.3
WEIGHT_CATEGORY_MATCH=0.2
