APP_NAME=Senior Care Platform
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration (sqlite or mysql)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# For MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=senior_care_db
# DB_USERNAME=root
# DB_PASSWORD=secret

# AI & Geo-matching Parameters
GEO_MAX_RADIUS_KM=5.0
WEIGHT_DISTANCE=0.5
WEIGHT_RATING=0.3
WEIGHT_CATEGORY_MATCH=0.2
