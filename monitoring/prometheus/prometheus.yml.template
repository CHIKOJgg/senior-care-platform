global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    service: care-platform

rule_files:
  - /etc/prometheus/alerts.yml

scrape_configs:
  - job_name: care-app
    metrics_path: /api/metrics
    authorization:
      type: Bearer
      credentials: __METRICS_TOKEN__
    static_configs:
      - targets: ['app:80']
        labels:
          service: care-app

  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: mysql
    static_configs:
      - targets: ['mysqld-exporter:9104']
        labels:
          service: mysql
